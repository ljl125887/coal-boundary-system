{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/coal-piles-result-1.0.schema.json",
  "title": "煤堆边界结果 1.0",
  "type": "object",
  "required": ["schema_version", "created_at", "metadata", "crs", "summary", "piles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object"},
    "crs": {
      "type": "object",
      "required": ["source_epsg", "output_epsg"],
      "properties": {
        "source_epsg": {"type": "integer"},
        "output_epsg": {"const": 4326}
      }
    },
    "summary": {
      "type": "object",
      "required": ["pile_count", "total_area_m2", "total_volume_m3", "quality_grades"],
      "properties": {
        "pile_count": {"type": "integer", "minimum": 0},
        "total_area_m2": {"type": "number", "minimum": 0},
        "total_volume_m3": {"type": "number", "minimum": 0},
        "quality_grades": {
          "type": "object",
          "required": ["A", "B", "C"],
          "properties": {
            "A": {"type": "integer", "minimum": 0},
            "B": {"type": "integer", "minimum": 0},
            "C": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      }
    },
    "evaluation": {"type": ["object", "null"]},
    "piles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pile_id", "area_m2", "volume_m3", "max_relative_height_m",
          "mean_relative_height_m", "quality_score", "quality_grade",
          "boundary_confidence", "pixel_count", "geometry"
        ],
        "properties": {
          "pile_id": {"type": "integer", "minimum": 1},
          "area_m2": {"type": "number", "minimum": 0},
          "volume_m3": {"type": "number", "minimum": 0},
          "max_relative_height_m": {"type": "number", "minimum": 0},
          "mean_relative_height_m": {"type": "number", "minimum": 0},
          "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
          "quality_grade": {"enum": ["A", "B", "C"]},
          "boundary_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "pixel_count": {"type": "integer", "minimum": 0},
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {"const": "Polygon"},
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {"type": "number"},
                      {"type": "number"}
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "display_geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {"const": "Polygon"},
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {"type": "number"},
                      {"type": "number"}
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "display_geometry_metrics": {"type": "object"}
        }
      }
    }
  }
}
